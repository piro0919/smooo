# Local values come from `supabase start` (ports are shifted to 553xx so Spatto can run alongside)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read by supabase/config.toml for Google sign-in on the local stack
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server only. `supabase status -o env` prints the local one as SECRET_KEY
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
