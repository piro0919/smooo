# Local values come from `supabase status -o env` (ports are shifted to 553xx so Spatto can run alongside)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. `supabase status -o env` prints the local one as SECRET_KEY
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Every post calls the model several times and bills this key. Leave it empty unless you mean to
ANTHROPIC_API_KEY=

# Google sign-in on the local stack. These two go in supabase/.env, not here:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
